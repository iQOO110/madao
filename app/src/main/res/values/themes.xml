<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Apple / macOS 风格主题：浅色画布 + 单一 Action Blue 强调色 + 细边框卡片 -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>

        <item name="android:colorBackground">@color/apple_parchment</item>
        <item name="colorSurface">@color/apple_canvas</item>
        <item name="colorSurfaceVariant">@color/apple_pearl</item>
        <item name="colorOnSurface">@color/apple_ink</item>
        <item name="colorOnSurfaceVariant">@color/apple_muted</item>
        <item name="colorOutline">@color/apple_hairline</item>
        <item name="colorOutlineVariant">@color/apple_divider</item>
        <item name="colorSecondaryContainer">@color/apple_pearl</item>
        <item name="colorOnSecondaryContainer">@color/brand_primary</item>

        <item name="android:statusBarColor">@color/apple_parchment</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/apple_parchment</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <style name="AppTheme.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/apple_parchment</item>
        <item name="titleTextAppearance">@style/Apple.ToolbarTitle</item>
    </style>

    <style name="AppTheme.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/apple_hairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/apple_canvas</item>
    </style>

</resources>